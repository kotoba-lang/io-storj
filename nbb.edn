;; nbb reads this file and does NOT read deps.edn.
;;
;; EVERY git coordinate from deps.edn is copied, not the subset the entry
;; points name: the namespace they need arrives transitively, and
;; tools.deps resolves that chain while nbb does not. The Maven
;; coordinates are left out because nbb does not resolve them.
;;
;; :paths and every sha are COPIED, not chosen here.
{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
        io.github.kotoba-lang/sigv4 {:git/sha "477e2b0c183f0e2cbefa2488e7f9133775d2840d"}
        io.github.kotoba-lang/bytes {:git/url "https://github.com/kotoba-lang/bytes.git" :git/sha "96ac992c7b0da54af41e8d40eaf23a4541a23d09"}}}
